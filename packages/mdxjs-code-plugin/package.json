{
  "name": "@mintsourcejs/mdxjs-code-plugin",
  "version": "0.3.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo"
  ],
  "type": "module",
  "description": "A plugin for @mdx-js/mdx@3.x to add underlying data/functionality to MDX documents required to support a live code editing implementation.",
  "license": "MIT",
  "author": "Ian Henshaw",
  "keywords": [
    "mdx",
    "mdxjs",
    "plugin",
    "live",
    "rehype"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mintsourcejs/mdsjx.git"
  },
  "bugs": {
    "url": "https://github.com/mintsourcejs/mdsjx/issues"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@mintsourcejs/mdxjs-common": "workspace:^",
    "@types/hast": "^3.0.5",
    "acorn": "^8.11.2",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-mdx-jsx": "^3.0.0",
    "mdast-util-mdxjs-esm": "^2.0.1",
    "micromark-extension-mdx-jsx": "^3.0.0",
    "micromark-extension-mdxjs-esm": "^3.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
